APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
# Optional for local shell startup; required for protected routes and readiness.
MONGODB_URI=
MONGODB_DATABASE=solaris
# Clerk Dashboard issuer URL and PEM public key. No client-supplied roles trusted.
AUTH_ISSUER=
AUTH_PUBLIC_KEY=
AUTH_AUTHORIZED_PARTIES=["http://localhost:5173"]
GEMINI_API_KEY=
ENABLE_PAID_API_CALLS=false
# Future private object storage adapter (not active in foundation).
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
